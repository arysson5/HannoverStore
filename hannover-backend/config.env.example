# Configurações do Backend Hannover Store
# Copie este arquivo para config.env e preencha com os valores reais

# JWT Secret (obrigatório em produção)
# Use um valor aleatório, por exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# Porta do servidor (opcional, padrão: 3002)
PORT=3002

# Ambiente (opcional, padrão: development)
NODE_ENV=development

# Chave API do Google AI (opcional, para funcionalidades de IA)
# Obtenha em: https://aistudio.google.com/
GOOGLE_AI_API_KEY=your-google-ai-api-key-here
